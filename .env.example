# SidPay - Automated UPI Payment Gateway
# Environment Configuration Template

# Server Port
PORT=3000

# Merchant Details
PAYEE_NAME="SidTech 366"
UPI_ID="yourhandle@upi"
BUSINESS_NAME="SidTech 366"

# Gmail IMAP Auto-Verification Configuration
# Note: Generate a 16-character App Password at: https://myaccount.google.com/apppasswords
GMAIL_USER="your-email@gmail.com"
GMAIL_APP_PASS="your-16-char-app-password"

# Database Configuration (MongoDB Atlas or Local MongoDB)
MONGODB_URI="mongodb+srv://<username>:<password>@cluster.mongodb.net/sidpay?retryWrites=true&w=majority"

# Appwrite Cloud Configuration (Optional - for Serverless Deployments)
APPWRITE_ENDPOINT="https://cloud.appwrite.io/v1"
APPWRITE_PROJECT_ID="your_appwrite_project_id"
APPWRITE_API_KEY="your_appwrite_api_key"

# ---------------- SidPay Security (REQUIRED) ----------------
# Only emails from these bank senders (email or domain, comma separated) can verify payments
ALLOWED_SENDERS="alerts@yourbank.com"
# Dashboard password for the default merchant (if empty, a random one is printed at startup)
MERCHANT_PASSWORD=""
# Test-only fake payment endpoint. Keep false in production!
ENABLE_SIMULATION=false

# Link customers get after successful payment (optional)
DELIVERY_VIEW_URL=""
DELIVERY_DOWNLOAD_URL=""

# ---------------- SMS Verification (Bank of Baroda / Jio Payments Bank) ----------------
# Long random secret shared with the SMS-forwarder app (min 16 chars)
SMS_WEBHOOK_SECRET=""
# Trusted bank SMS headers without prefix/suffix (JK-BOBSMS-S -> BOBSMS). Default: BOBSMS,BOBTXN,BOBUPI
SMS_ALLOWED_SENDERS="BOBSMS"
# Optional: last 4 digits of your account as shown in SMS (e.g. 3050)
SMS_ACCOUNT_LAST4=""

# Allow new merchant sign-ups from the website (keep false)
ALLOW_REGISTRATION=false
# Optional: secret for dashboard login sessions
SESSION_SECRET=""

# Apps whose "received" notifications can verify payments (MacroDroid [app_name])
NOTIFY_ALLOWED_APPS="PhonePe Business"
